{
  "name": "ableton-mcp-server-extension",
  "version": "0.6.0",
  "type": "module",
  "main": "dist/extension.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts",
    "build:prod": "tsc --noEmit && tsx build.ts --production",
    "watch": "tsx build.ts --watch",
    "package": "npm run build:prod && extensions-cli package",
    "gate0:typecheck": "tsc -p groove-brain-gate0/tsconfig.json --noEmit",
    "gate0:test": "tsx --test groove-brain-gate0/tests/*.test.ts",
    "gate0:build": "npm run gate0:typecheck && tsx groove-brain-gate0/build.ts",
    "gate0:export": "../.venv/Scripts/python.exe ../scripts/export_groove_index.py",
    "gate0:package": "npm run gate0:build && tsx groove-brain-gate0/package.ts --version 0.2.0"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:./vendor/ableton-extensions-sdk-1.0.0-beta.0.tgz",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:./vendor/ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@types/node": "^24.1.0",
    "@types/ws": "^8.5.13",
    "esbuild": "0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
